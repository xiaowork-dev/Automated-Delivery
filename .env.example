# Copy to .env or run the deploy script, which generates private random secrets.
# Never commit the real .env. Replace every CHANGE_ME value before manual startup.
DB_NAME=auto_delivery
DB_USER=autodelivery
DB_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_RANDOM_ROOT_PASSWORD
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_RANDOM_ADMIN_PASSWORD
APP_SEED_DEMO=false
REDIS_ENABLED=true
APP_BASE_URL=http://localhost
HTTP_PORT=80
HTTPS_PORT=443
BACKUP_RETENTION_DAYS=7
